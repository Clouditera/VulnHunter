# VulnHunt Service — Environment Variables
# Copy this file to .env and fill in actual values

PORT=28080
DATA_DIR=/data/vulnhunt

# Database
DB_PASSWORD=change-me-in-production

# MinIO
MINIO_ACCESS_KEY=change-me-in-production
MINIO_SECRET_KEY=change-me-in-production

# Required: explicit master key file path. Service reads this file only.
# File must contain exactly 64 hex chars (32 bytes). Generate once and keep stable:
#   openssl rand -hex 32 > .data/.master.key && chmod 0400 .data/.master.key
# Mount/backup this file together with the DB; credentials cannot be decrypted without it.
VULNHUNT_MASTER_KEY_FILE=/run/secrets/vulnhunt-master.key
# Dev/debug only: allow legacy fallback to DATA_DIR/.master.key when key file env is absent.
# VULNHUNT_ALLOW_DATA_DIR_MASTER_KEY_FALLBACK=1

# Logging
LOG_LEVEL=info
