# VulnHunter production deployment config

WEB_PORT=23000
# Optional debug API port. Service is normally accessed through nginx/web.
SERVICE_PORT=28080
# Admin console (default: all interfaces — the first-install wizard lives
# here and must be reachable from the network). Production: pin to a specific
# IP (e.g. 127.0.0.1) or use ssh -L 23001:127.0.0.1:23001 for remote admin.
ADMIN_LISTEN_ADDR=0.0.0.0
ADMIN_PORT=23001
DATA_DIR=/opt/vulnhunter/data

# Singleton system admin (deploy-provisioned). On every service start:
# ensures this account is admin+active+is_system and sets password from env.
# Leave empty to skip (legacy installs). Manage only via these keys — not UI.
# VULNHUNTER_ADMIN_EMAIL=admin@example.com
# VULNHUNTER_ADMIN_PASSWORD=change-me-strong-password

# community = open-core; enterprise = license/multi-user; saas = enterprise + ops (promo/credits/feedback).
EDITION=community

SERVICE_IMAGE=vulnhunter-service:latest
WEB_IMAGE=vulnhunter-web:latest
WORKER_IMAGE=vulnhunter-worker:latest
# URL workers use to call back into the service container.
# In customer/prod deployments, set this explicitly if the service container name/port differs.
WORKER_SERVICE_URL=http://service:28080
# Deployment-side source archive upload ceiling (MB).
# This drives packaged web nginx and the maximum value admins can configure in Settings.
UPLOAD_GATEWAY_LIMIT_MB=2048
POSTGRES_IMAGE=postgres:16-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

DB_PASSWORD=change-me-in-production
MINIO_ACCESS_KEY=change-me-in-production
MINIO_SECRET_KEY=change-me-in-production

# install.sh generates this file once under DATA_DIR. Back it up with DB/data.
MASTER_KEY_FILE=/opt/vulnhunter/data/.secrets/vulnhunter-master.key
VULNHUNTER_MASTER_KEY_FILE=/opt/vulnhunter/data/.secrets/vulnhunter-master.key

# Enterprise license verifier public key. Release packages include this file under .secrets/.
LICENSE_PUBLIC_KEY_FILE=./.secrets/license-public.pem
VULNHUNTER_LICENSE_PUBLIC_KEY_FILE=/run/secrets/license-public.pem

# install.sh sets these. Non-root installs run service as the installer uid/gid.
# Root installs keep the image default service uid/gid and chown data/secrets accordingly.
SERVICE_UID=1001
SERVICE_GID=1001

# install.sh auto-detects this from /var/run/docker.sock so the service user can launch worker containers.
DOCKER_GID=0

# Docker bridge subnet for VulnHunter containers.
# Change this if it conflicts with the customer's LAN/VPN routes.
DOCKER_SUBNET=10.177.0.0/24
# Network chat/worker containers join. Fresh installs derive <PROJECT_NAME>-internal
# automatically; only set this to attach to a pre-existing custom network.
# DOCKER_NETWORK=vulnhunter-internal

LOG_LEVEL=info

# Former POC/EXP settings (UI offline). Deploy-level only.
POC_RUN_TIMEOUT_S=1800
EVAL_CONTAINER_NETWORK=bridge

# SandboxPlane integration (v2.3.0 dynamic verification). Leave empty when no
# SandboxPlane service is deployed — static scans are unaffected and dynamic
# tasks fail closed with a visible reason.
# SandboxPlane (dynamic verification) — written by sandbox/install.sh on same-host install.
# Leave empty to keep dynamic features disabled (fail-closed).
# SANDBOXPLANE_BASE_URL=http://sandbox-plane:28090
# SANDBOXPLANE_TOKEN=
# Optional: worker-facing ssh host when SandboxPlane runs on another host
# (default: the plane's reported host, loopback auto-translated to the docker host gateway).
# SANDBOX_SSH_HOST_OVERRIDE=

# ── Remote SandboxPlane mode: the four keys below are REQUIRED TOGETHER ──
# (plane URL + token above, bastion + identity below). The identity must be a
# private-key FILE that outlives service restarts (put it under
# $DATA_DIR/.secrets/, chmod 600) — a temp export silently disables dynamic
# verification after the next restart (2026-08-04 incident).
# Bastion jump for remote SandboxPlane (empty = direct port-mapping, local mode).
# Format: user@host or user@host:port / user@[ipv6]:port
# SANDBOX_SSH_BASTION=
# Bastion host public key line (ssh-ed25519 AAAA...) — required for full pin on the jump hop.
# SANDBOX_SSH_BASTION_HOST_KEY=
# OpenSSH private key file authenticating to the bastion (required for remote mode).
# SANDBOX_SSH_BASTION_IDENTITY=
