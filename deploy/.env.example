# VulnHunt production deployment config

WEB_PORT=23000
# Optional debug API port. Service is normally accessed through nginx/web.
SERVICE_PORT=28080
DATA_DIR=/opt/vulnhunt/data

SERVICE_IMAGE=vulnhunt-service:latest
WEB_IMAGE=vulnhunt-web:latest
WORKER_IMAGE=vulnhunt-worker:latest
EVAL_WORKER_IMAGE=vulnhunt-eval-worker:latest
POSTGRES_IMAGE=postgres:16-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

DB_PASSWORD=change-me-in-production
MINIO_ACCESS_KEY=change-me-in-production
MINIO_SECRET_KEY=change-me-in-production

# install.sh generates this file once. Back it up with DB/data.
MASTER_KEY_FILE=./.secrets/vulnhunt-master.key
VULNHUNT_MASTER_KEY_FILE=/run/secrets/vulnhunt-master.key

# License public key placeholder. License hardening is implemented in a separate task.
LICENSE_PUBLIC_KEY_FILE=./.secrets/license-public.pem
VULNHUNT_LICENSE_PUBLIC_KEY_FILE=/run/secrets/license-public.pem

LOG_LEVEL=info
