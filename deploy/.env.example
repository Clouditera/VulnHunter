# VulnHunt Service — Environment Variables
# Copy this file to .env and fill in actual values

PORT=8080
DATA_DIR=/data/vulnhunt

# Database
DB_PASSWORD=change-me-in-production

# MinIO
MINIO_ACCESS_KEY=change-me-in-production
MINIO_SECRET_KEY=change-me-in-production

# Optional: override master key source (32 bytes hex)
# If unset, key is auto-generated and stored in DATA_DIR/.master.key
# VULNHUNT_MASTER_KEY=

# Logging
LOG_LEVEL=info
