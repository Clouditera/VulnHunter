{
  "name": "@vulnhunter/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc && cp -r src/infra/db/migrations dist/infra/db/ && mkdir -p dist/features/prepare && cp -r src/features/prepare/schemas dist/features/prepare/ && mkdir -p dist/features/auth/legal && cp -r src/features/auth/legal/. dist/features/auth/legal/",
    "dev": "node --watch --experimental-specifier-resolution=node dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@vulnhunter/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "dockerode": "^4.0.4",
    "file-type": "^20.5.0",
    "hono": "^4.7.4",
    "js-yaml": "^4.1.0",
    "minio": "^8.0.5",
    "mime-types": "^2.1.35",
    "nodemailer": "^9.0.3",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "tar": "^7.5.19",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1",
    "@earendil-works/pi-ai": "0.83.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/dockerode": "^3.3.34",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@types/yauzl": "^2.10.3",
    "ajv": "8.17.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "exports": {
    ".": "./dist/main.js",
    "./enterprise-api": "./dist/enterprise-api.js"
  },
  "license": "AGPL-3.0-only"
}
