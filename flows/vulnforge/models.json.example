{
  "providers": {
    "zai": {
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "api": "openai-completions",
      "apiKey": "$ZAI_API_KEY",
      "models": [
        {
          "id": "glm-5.1",
          "input": ["text"],
          "contextWindow": 200000,
          "maxTokens": 80000,
          "reasoning": true
        }
      ]
    },
    "openai-proxy": {
      "baseUrl": "https://your-openai-compatible-endpoint/v1",
      "api": "openai-responses",
      "apiKey": "$OPENAI_PROXY_API_KEY",
      "models": [
        {
          "id": "gpt-5.5",
          "name": "GPT-5.5",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 272000,
          "maxTokens": 128000
        }
      ]
    }
  }
}
